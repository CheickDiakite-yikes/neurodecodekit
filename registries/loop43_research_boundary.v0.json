  "future_acceptance_gates": [
    {"requirement_id": "L43-G01", "requirement": "A versioned preregistration freezes the eligible artifact packet oracle comparison resources security privacy independence outcomes and claims before creation or execution."},
    {"requirement_id": "L43-G02", "requirement": "Each future stage has a separate exact authorization-only commit that is pushed and green before the stage begins."},
    {"requirement_id": "L43-G03", "requirement": "Loop 37 release-envelope Loop 38 lifecycle and Loop 39 required-matrix dependencies close compatibly before public challenge launch."},
    {"requirement_id": "L43-G04", "requirement": "The selected artifact is target-free synthetic release-eligible and contains no protected recording target label prompt consumed output model checkpoint or participant field."},
    {"requirement_id": "L43-G05", "requirement": "Source commit dirty state instructions commands inputs outputs dependencies comparison policy and claim ceiling are hash-bound."},
    {"requirement_id": "L43-G06", "requirement": "The public packet is sufficient without private maintainer state undocumented hand edits paid services or proprietary software."},
    {"requirement_id": "L43-G07", "requirement": "A maintainer dry run is recorded only as repeatability and cannot satisfy the independent-reproducer gate."},
    {"requirement_id": "L43-G08", "requirement": "The independent reproducer did not author the target implementation fixture oracle expected outputs or comparison policy."},
    {"requirement_id": "L43-G09", "requirement": "Repository write access prior artifact access relationships conflicts private guidance and communication channels are disclosed."},
    {"requirement_id": "L43-G10", "requirement": "All result-specific communication is public hash-bound and retained while sensitive or conduct matters use the existing private policies without leaking challenge evidence."},
    {"requirement_id": "L43-G11", "requirement": "The reproducer uses a clean root and separately records operating system architecture Python installer dependencies numerical backends threads locale timezone and filesystem behavior."},
    {"requirement_id": "L43-G12", "requirement": "The checker records commands outputs obstacles and discrepancies but does not repair the package or silently change the protocol during the run."},
    {"requirement_id": "L43-G13", "requirement": "The submission core and its commitment hash freeze before the oracle or expected comparison outcome is revealed."},
    {"requirement_id": "L43-G14", "requirement": "Oracle reveal verifies the prior commitment and any mismatch invalidates rather than reinterprets the submission."},
    {"requirement_id": "L43-G15", "requirement": "Semantic identity timestamps indices lengths masks splits causal flags state warnings and refusals compare exactly."},
    {"requirement_id": "L43-G16", "requirement": "Floating fields use only the preregistered Loop 39 field-specific policy and no post-submission tolerance change is allowed."},
    {"requirement_id": "L43-G17", "requirement": "Container byte identity stays separate from canonical payload and semantic identity."},
    {"requirement_id": "L43-G18", "requirement": "Runtime RSS setup time command count manual steps network bytes and artifact bytes are measured but cannot weaken semantic gates."},
    {"requirement_id": "L43-G19", "requirement": "Negative partial failed unsupported and unavailable outcomes remain public first-class records rather than being discarded or rerun away."},
    {"requirement_id": "L43-G20", "requirement": "Every discrepancy receives one frozen class evidence pointer owner and resolution state without changing the original submission."},
    {"requirement_id": "L43-G21", "requirement": "A protocol or code repair creates a new version and new challenge evidence rather than overwriting the original failure."},
    {"requirement_id": "L43-G22", "requirement": "Fork pull request code runs only with unprivileged read-only context and receives no repository secret token protected cache or trusted artifact."},
    {"requirement_id": "L43-G23", "requirement": "No pull_request_target or privileged workflow checks out and executes untrusted fork code."},
    {"requirement_id": "L43-G24", "requirement": "Every submission passes forbidden-field secret path participant target neural-payload and archive traversal checks before public review."},
    {"requirement_id": "L43-G25", "requirement": "No contributor-owned EEG or participant artifact is uploaded or counted in the core challenge."},
    {"requirement_id": "L43-G26", "requirement": "Optional contributor-owned-data extensions require another protocol remain local and cannot upgrade the core artifact result."},
    {"requirement_id": "L43-G27", "requirement": "Credit name alias affiliation and archive consent are explicit and can be withheld without invalidating technical evidence."},
    {"requirement_id": "L43-G28", "requirement": "One external reproducer can establish only the exact artifact and environment outcome not user population model modality device or hardware generalization."},
    {"requirement_id": "L43-G29", "requirement": "Reproduction using author artifacts cannot be relabeled independent implementation or scientific replication."},
    {"requirement_id": "L43-G30", "requirement": "A different implementation or data acquisition requires a separately preregistered scientific replication protocol."},
    {"requirement_id": "L43-G31", "requirement": "No result upgrades neural advantage decoding accuracy unseen-person transfer real-time latency device safety privacy license or clinical claims."},
    {"requirement_id": "L43-G32", "requirement": "Challenge packet submission and adjudication artifacts each stay under their byte caps and one-thread one-worker CPU limits."},
    {"requirement_id": "L43-G33", "requirement": "Network activity ends after bounded public setup and all runtime network requests are zero or explicitly fail the run."},
    {"requirement_id": "L43-G34", "requirement": "Public archive DOI release or badge language requires separate authority and Loop 44 review."},
    {"requirement_id": "L43-G35", "requirement": "An independent adjudicator distinct from artifact authors and the reproducer verifies eligibility ordering hashes comparisons and claims before Level Q5."},
    {"requirement_id": "L43-G36", "requirement": "The final report states one engineering capability sentence and one separate scientific claim not established sentence."}
  ],
