  "future_requirements": [
    {
      "requirement_id": "L30-G01_target_free_trace",
      "gate": "One new deterministic trace is generated solely from a future frozen seed and contains no targets, labels, prompts, real text, consumed predictions, metrics, logits, or checkpoints."
    },
    {
      "requirement_id": "L30-G02_trace_schema",
      "gate": "Every event validates against the frozen identity, timing, revision, causality, hash, warning, and unavailable-field schema."
    },
    {
      "requirement_id": "L30-G03_source_mode",
      "gate": "Source mode is mutually exclusive, machine-readable, and visible throughout replay."
    },
    {
      "requirement_id": "L30-G04_proof_posture",
      "gate": "Proof posture and claim boundary remain visible in every predictive or trace view."
    },
    {
      "requirement_id": "L30-G05_causality",
      "gate": "Producer and decoder causality plus required left and right context are displayed separately."
    },
    {
      "requirement_id": "L30-G06_revision_ledger",
      "gate": "Each changed hypothesis records prior identity, edit distance, cumulative revisions, edit overhead, committed prefix, and stable duration."
    },
    {
      "requirement_id": "L30-G07_finalization",
      "gate": "Finalization is an explicit event with a frozen reason and is never inferred from silence or stability."
    },
    {
      "requirement_id": "L30-G08_confidence",
      "gate": "Predictive confidence remains unavailable and stability, entropy, color, or logits are not relabeled as calibration."
    },
    {
      "requirement_id": "L30-G09_no_signal_comparator",
      "gate": "The no-signal comparator and its exact evidence status remain visible beside any future predictive artifact."
    },
    {
      "requirement_id": "L30-G10_clock_domains",
      "gate": "All nine clock domains retain origin and units; cross-origin subtraction fails without an explicit mapping ledger."
    },
    {
      "requirement_id": "L30-G11_latency_ladder",
      "gate": "Every latency statement names one of six levels and Loop 30 never exceeds local replay presentation Level 3."
    },
    {
      "requirement_id": "L30-G12_loopback_privacy",
      "gate": "The launcher fixes 127.0.0.1, share false, analytics false, monitoring false, strict CORS true, one thread, one worker, and two sessions."
    },
    {
      "requirement_id": "L30-G13_file_exposure",
      "gate": "Uploads, arbitrary files, allowed directories, static directories, and project/data/cache/secret path serving are refused."
    },
    {
      "requirement_id": "L30-G14_browser_network",
      "gate": "Playwright records requests, responses, WebSockets, pages, and service workers; every non-loopback operation fails."
    },
    {
      "requirement_id": "L30-G15_browser_responsiveness",
      "gate": "The fixed replay has zero W3C-defined long tasks at or above 50 ms and reports Event Timing support or unavailability."
    },
    {
      "requirement_id": "L30-G16_accessibility",
      "gate": "Textual labels, status/log semantics, keyboard access, polite announcements, stable focus, no forced scroll, and reduced motion pass."
    },
    {
      "requirement_id": "L30-G17_resources",
      "gate": "Input/output bytes, runtime, peak RSS, one thread/worker, 32 MiB artifacts, and 1 GiB RSS all validate before closeout."
    },
    {
      "requirement_id": "L30-G18_access_and_claim_closeout",
      "gate": "All protected-access counters, warnings, unavailable fields, hashes, tests, screenshots, and engineering-versus-science closeout statements are complete."
    }
  ],
